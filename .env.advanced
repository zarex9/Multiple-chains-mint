# Environment Configuration Template
# Copy this to .env and fill in your values

# ==================== Smart Contract Deployment ====================
PRIVATE_KEY=your_private_key_here

# ==================== Network RPC URLs ====================
CELO_ALFAJORES_RPC=https://alfajores-forno.celo-testnet.org
CELO_RPC=https://forno.celo.org

ARB_GOERLI_RPC=https://goerli-rollup.arbitrum.io/rpc
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

BASE_TEST_RPC=https://goerli.base.org
BASE_RPC=https://mainnet.base.org

# ==================== Frontend Configuration ====================
REACT_APP_WALLETCONNECT_ID=your_walletconnect_project_id

# Contract addresses (update after deployment)
REACT_APP_CELO_CONTRACT=0x...
REACT_APP_ARB_CONTRACT=0x...
REACT_APP_BASE_CONTRACT=0x...

# Optional RPC URLs for frontend (if not using WalletConnect)
REACT_APP_CELO_RPC=https://forno.celo.org
REACT_APP_ARB_RPC=https://arb1.arbitrum.io/rpc
REACT_APP_BASE_RPC=https://mainnet.base.org

# ==================== Block Explorer Verification ====================
CELOSCAN_KEY=your_celoscan_api_key
ARBISCAN_KEY=your_arbiscan_api_key
BASESCAN_KEY=your_basescan_api_key

# ==================== Optional: Deployment Settings ====================
# Max supply for NFT collection
REACT_APP_MAX_SUPPLY=10000

# Initial mint price (in ETH)
REACT_APP_INITIAL_PRICE=0.01

# Royalty percentage (in basis points: 500 = 5%)
REACT_APP_ROYALTY_PERCENTAGE=500

# Royalty recipient address
REACT_APP_ROYALTY_RECIPIENT=0x...

# ==================== Development ====================
NODE_ENV=development
GENERATE_SOURCEMAP=false
