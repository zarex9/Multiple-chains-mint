### WalletConnect + Multi-Chain NFT Config

# WalletConnect Project ID
REACT_APP_WALLETCONNECT_ID=your_walletconnect_id_here

# RPC endpoints (MAINNET)
REACT_APP_CELO_RPC=https://forno.celo.org
REACT_APP_ARB_RPC=https://arb1.arbitrum.io/rpc
REACT_APP_BASE_RPC=https://mainnet.base.org

# RPC endpoints (TESTNETS)
REACT_APP_CELO_TESTNET_RPC=https://alfajores-forno.celo-testnet.org
REACT_APP_ARBITRUM_TESTNET_RPC=https://goerli-rollup.arbitrum.io/rpc
REACT_APP_BASE_TESTNET_RPC=https://goerli.base.org

# Contract + Mint settings
REACT_APP_NFT_NAME=MyNFT
REACT_APP_NFT_SYMBOL=MNFT
REACT_APP_MAX_SUPPLY=1000
REACT_APP_MINT_PRICE=0.01

# (OPTIONAL) Explorer API keys for automated verification
REACT_APP_ARBISCAN_KEY=
REACT_APP_BASESCAN_KEY=
REACT_APP_CELOSCAN_KEY=
