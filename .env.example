### Example environment variables for Multi-Chain NFT
# Replace placeholders with real values before running

# Private key of deployer (0x...)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC endpoints (replace with Infura/Alchemy/QuickNode or similar)
CELO_ALFAJORES_RPC=https://alfajores-forno.celo-testnet.org
CELO_RPC=https://forno.celo.org
ARB_GOERLI_RPC=https://goerli-rollup.arbitrum.io/rpc
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
BASE_RPC=https://mainnet.base.org
BASE_TEST_RPC=https://goerli.base.org

# Explorer API keys (optional, for contract verification)
ARBISCAN_KEY=
BASESCAN_KEY=
CELOSCAN_KEY=

# NFT deployment settings
NFT_NAME=MyNFT
NFT_SYMBOL=MNFT
MAX_SUPPLY=1000
MINT_PRICE=0.01
